# Database Configuration
# Use the Supabase pooler connection string if your network is IPv4-only.
# Example: postgresql://postgres:password@db.merjiupvuzivxyvcdjfs.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.merjiupvuzivxyvcdjfs.supabase.co:5432/postgres
PGSSLMODE=require
# For local development (comment out DATABASE_URL above and use these):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=personal_finance_tracker
# DB_USER=postgres
# DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=24h

# Server Configuration
NODE_ENV=development
PORT=8000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
